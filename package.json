{
  "name": "proof-and-state-portfolio",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/gtm-orchestrator"
  ],
  "scripts": {
    "test": "npm run test:governance && npm run test:gtm",
    "test:governance": "node --test scripts/portfolio-state.test.mjs scripts/check-main-environment-governance.test.mjs",
    "test:gtm": "npm run test --workspace=@proof-and-state/gtm-orchestrator",
    "governance:render": "node scripts/render-portfolio-state.mjs",
    "governance:check": "node scripts/render-portfolio-state.mjs --check && node scripts/check-main-environment-governance.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "wrangler": "4.127.1"
  }
}
